# Kopie als .env anlegen und ausfüllen — .env ist in .gitignore und bleibt lokal.
# Niemals echte Keys committen. In GitHub Actions kommen die Werte aus GitHub Secrets.

# Alpaca Trading API (Paper) — Kern
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# eToro Public API — Satellit (Demo-Modus)
# ACHTUNG, die eToro-UI beschriftet die Werte irreführend (verifiziert 2026-09-06):
#   ETORO_API_KEY  = das Feld "Öffentlicher Schlüssel" in der API-Schlüsselverwaltung
#   ETORO_USER_KEY = der beim "API-Schlüssel erstellen" generierte lange Wert (eyJ...)
ETORO_API_KEY=
ETORO_USER_KEY=
